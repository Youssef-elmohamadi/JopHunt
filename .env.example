# Telegram API Credentials (from https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash_here
TG_SESSION_NAME=atrees_userbot

# Target Telegram Channels/Groups (Comma-separated: usernames like @channel or IDs like -100123456789)
TARGET_CHANNELS=@mostaql_jobs,@freelance_alerts,-1001234567890

# Multi-Model AI Engine Settings (Failover Chain)
# Provider 1: Google Gemini API (Free tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Provider 2: Groq API (Ultra-fast & Free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Provider 3: Ollama Local Fallback (Free & Offline: https://ollama.ai)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Notification & Approval Bot Settings
BOT_TOKEN=your_bot_father_token_here
MY_CHAT_ID=your_telegram_user_id_here

# Automation & Submitter Settings
# BROWSER_HEADLESS=false keeps the browser window visible so you can watch it fill or log in
BROWSER_HEADLESS=false
# AUTO_SUBMIT_CONFIRM=false fills the proposal and pauses for review; set to true for fully unattended auto-submission
AUTO_SUBMIT_CONFIRM=false
